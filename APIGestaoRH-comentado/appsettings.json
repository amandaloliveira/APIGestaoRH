{ // Abre o objeto JSON raiz de configuração da aplicação[cite: 22]
  "ConnectionStrings": { // Secção que agrupa as cadeias de ligação a bases de dados[cite: 22]
    "DefaultConnection": "Data Source=gestaorh.db" // Define a ligação padrão para o ficheiro de base de dados SQLite "gestaorh.db"[cite: 22]
  }, // Fecha ConnectionStrings[cite: 22]
  "Logging": { // Secção de configuração do sistema de registos (logs)[cite: 22]
    "LogLevel": { // Define os níveis mínimos de severidade dos logs por categoria[cite: 22]
      "Default": "Information", // Nível padrão de log para a aplicação como um todo[cite: 22]
      "Microsoft.AspNetCore": "Warning" // Nível de log para componentes internos do ASP.NET Core (apenas avisos ou superior)[cite: 22]
    } // Fecha LogLevel[cite: 22]
  }, // Fecha Logging[cite: 22]
  "AllowedHosts": "*" // Permite pedidos provenientes de qualquer nome de anfitrião (host)[cite: 22]
} // Fecha o JSON raiz[cite: 22]
