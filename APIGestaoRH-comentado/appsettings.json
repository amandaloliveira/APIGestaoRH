{ // Abre o objeto JSON raiz de configuração da aplicação
  "ConnectionStrings": { // Secção que agrupa as cadeias de ligação a bases de dados
    "DefaultConnection": "Data Source=gestaorh.db" // Define a ligação padrão para o ficheiro de base de dados SQLite "gestaorh.db"
  }, // Fecha ConnectionStrings
  "Logging": { // Secção de configuração do sistema de registos (logs)
    "LogLevel": { // Define os níveis mínimos de severidade dos logs por categoria
      "Default": "Information", // Nível padrão de log para a aplicação como um todo
      "Microsoft.AspNetCore": "Warning" // Nível de log para componentes internos do ASP.NET Core (apenas avisos ou superior)
    } // Fecha LogLevel
  }, // Fecha Logging
  "AllowedHosts": "*" // Permite pedidos provenientes de qualquer nome de anfitrião (host)
} // Fecha o JSON raiz
