@host = http://localhost:5135
<!-- Define uma variável @host com a URL base da API em HTTP -->

// 1. Cadastrar um Gestor (lado 1 do relacionamento 1:N)
POST {{host}}/api/Gestores <!-- Envia requisição HTTP POST para criar um gestor usando a variável @host -->
Content-Type: application/json <!-- Informa que o corpo da requisição está no formato JSON -->

{ <!-- Abre o objeto JSON com os dados do gestor -->
  "nome": "Ricardo Almeida", <!-- Nome do gestor -->
  "setor": "Tecnologia", <!-- Setor do gestor -->
  "email": "ricardo.almeida@empresa.com" <!-- E-mail do gestor -->
} <!-- Fecha o objeto JSON -->

// 2. Listar Gestores (mostra o gestor e sua lista de funcionários)
GET {{host}}/api/Gestores <!-- Envia requisição HTTP GET para listar todos os gestores -->
Accept: application/json <!-- Solicita a resposta no formato JSON -->

// 3. Cadastrar um Funcionário vinculado ao Gestor Id 1
POST {{host}}/api/Funcionarios <!-- Envia requisição HTTP POST para cadastrar um funcionário -->
Content-Type: application/json <!-- Define o tipo de conteúdo como JSON -->

{ <!-- Abre o objeto JSON do funcionário -->
  "nome": "Mariana Costa", <!-- Nome da funcionária -->
  "cpf": "123.456.789-00", <!-- CPF da funcionária -->
  "cargo": "Desenvolvedora Pleno", <!-- Cargo da funcionária -->
  "setor": "Tecnologia", <!-- Setor da funcionária -->
  "salario": 7200.00, <!-- Salário da funcionária -->
  "gestorId": 1 <!-- ID do gestor responsável (relacionamento 1:N) -->
} <!-- Fecha o objeto JSON -->

// 4. Listar todos os funcionários registrados
GET {{host}}/api/Funcionarios <!-- Envia requisição HTTP GET para listar todos os funcionários -->
Accept: application/json <!-- Indica preferência por resposta JSON -->

// 5. Listar um funcionário específico pelo Id
GET {{host}}/api/Funcionarios/1 <!-- Envia requisição HTTP GET buscando o funcionário com Id 1 -->
Accept: application/json <!-- Indica preferência por resposta JSON -->

// 6. Listar funcionários de um setor específico
GET {{host}}/api/Funcionarios/setor/Tecnologia <!-- Envia requisição HTTP GET filtrando funcionários do setor "Tecnologia" -->
Accept: application/json <!-- Indica preferência por resposta JSON -->

// 7. Alterar dados do funcionário (cargo, salário ou setor)
PUT {{host}}/api/Funcionarios/1 <!-- Envia requisição HTTP PUT para atualizar o funcionário de Id 1 -->
Content-Type: application/json <!-- Define o corpo como JSON -->

{ <!-- Abre o JSON com os novos dados do funcionário -->
  "nome": "Mariana Costa", <!-- Nome atualizado/mantido -->
  "cpf": "123.456.789-00", <!-- CPF atualizado/mantido -->
  "cargo": "Tech Lead", <!-- Novo cargo -->
  "setor": "Arquitetura", <!-- Novo setor -->
  "salario": 11500.00, <!-- Novo salário -->
  "gestorId": 1 <!-- ID do gestor vinculado -->
} <!-- Fecha o JSON -->

// 8. Remover o funcionário do banco de dados
DELETE {{host}}/api/Funcionarios/1 <!-- Envia requisição HTTP DELETE para excluir o funcionário de Id 1 -->
