{ // Abre o objeto JSON raiz de configuração dos perfis de execução[cite: 12]
  "$schema": "https://json.schemastore.org/launchsettings.json", // Indica o esquema JSON para validação e autocomplete no editor[cite: 12]
  "profiles": { // Define os perfis de inicialização da aplicação (como dotnet run ou Visual Studio)[cite: 12]
    "http": { // Perfil de execução configurado apenas para HTTP[cite: 12]
      "commandName": "Project", // Executa o projeto .NET diretamente[cite: 12]
      "dotnetRunMessages": true, // Exibe mensagens informativas do comando dotnet run no console[cite: 12]
      "launchBrowser": true, // Abre o navegador automaticamente quando a aplicação inicia[cite: 12]
      "launchUrl": "swagger", // Define a rota inicial aberta no navegador (/swagger)[cite: 12]
      "applicationUrl": "http://localhost:5135", // Define o endereço HTTP em que a API vai escutar[cite: 12]
      "environmentVariables": { // Variáveis de ambiente aplicadas durante a execução deste perfil[cite: 12]
        "ASPNETCORE_ENVIRONMENT": "Development" // Define o ambiente como Development (ativa recursos de desenvolvimento)[cite: 12]
      } // Fecha environmentVariables do perfil http[cite: 12]
    }, // Fecha o perfil http[cite: 12]
    "https": { // Perfil de execução configurado para HTTPS (e fallback HTTP)[cite: 12]
      "commandName": "Project", // Executa o projeto .NET diretamente[cite: 12]
      "dotnetRunMessages": true, // Exibe mensagens informativas do dotnet run no terminal[cite: 12]
      "launchBrowser": true, // Abre o navegador automaticamente ao iniciar[cite: 12]
      "launchUrl": "swagger", // Abre diretamente a interface do Swagger no navegador[cite: 12]
      "applicationUrl": "https://localhost:7296;http://localhost:5135", // Define os endereços HTTPS (7296) e HTTP (5135) da API[cite: 12]
      "environmentVariables": { // Variáveis de ambiente para o perfil https[cite: 12]
        "ASPNETCORE_ENVIRONMENT": "Development" // Mantém o ambiente em Development[cite: 12]
      } // Fecha environmentVariables do perfil https[cite: 12]
    } // Fecha o perfil https[cite: 12]
  } // Fecha profiles[cite: 12]
} // Fecha o JSON raiz[cite: 12]
