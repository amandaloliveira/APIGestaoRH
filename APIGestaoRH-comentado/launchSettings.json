{ // Abre o objeto JSON raiz de configuração dos perfis de execução
  "$schema": "https://json.schemastore.org/launchsettings.json", // Indica o esquema JSON para validação e autocomplete no editor
  "profiles": { // Define os perfis de inicialização da aplicação (como dotnet run ou Visual Studio)
    "http": { // Perfil de execução configurado apenas para HTTP
      "commandName": "Project", // Executa o projeto .NET diretamente
      "dotnetRunMessages": true, // Exibe mensagens informativas do comando dotnet run no console
      "launchBrowser": true, // Abre o navegador automaticamente quando a aplicação inicia
      "launchUrl": "swagger", // Define a rota inicial aberta no navegador (/swagger)
      "applicationUrl": "http://localhost:5135", // Define o endereço HTTP em que a API vai escutar
      "environmentVariables": { // Variáveis de ambiente aplicadas durante a execução deste perfil
        "ASPNETCORE_ENVIRONMENT": "Development" // Define o ambiente como Development (ativa recursos de desenvolvimento)
      } // Fecha environmentVariables do perfil http
    }, // Fecha o perfil http
    "https": { // Perfil de execução configurado para HTTPS (e fallback HTTP)
      "commandName": "Project", // Executa o projeto .NET diretamente
      "dotnetRunMessages": true, // Exibe mensagens informativas do dotnet run no terminal
      "launchBrowser": true, // Abre o navegador automaticamente ao iniciar
      "launchUrl": "swagger", // Abre diretamente a interface do Swagger no navegador
      "applicationUrl": "https://localhost:7296;http://localhost:5135", // Define os endereços HTTPS (7296) e HTTP (5135) da API
      "environmentVariables": { // Variáveis de ambiente para o perfil https
        "ASPNETCORE_ENVIRONMENT": "Development" // Mantém o ambiente em Development
      } // Fecha environmentVariables do perfil https
    } // Fecha o perfil https
  } // Fecha profiles
} // Fecha o JSON raiz
